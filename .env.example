# Optional development-server proxy target for Java `/api` requests.
# If omitted, vite.config.js defaults to the local Spring Boot service.
VITE_API_PROXY_TARGET=http://localhost:30002

# API base URL. Leave empty in local development to use Vite's /api proxy.
VITE_API_BASE_URL=

# Request timeout in milliseconds.
VITE_REQUEST_TIMEOUT=15000

# Public OSS asset domain used by the frontend.
VITE_OSS_DOMAIN=https://food-cinder.oss-cn-beijing.aliyuncs.com
