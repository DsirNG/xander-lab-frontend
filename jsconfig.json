{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@app/*": ["src/app/*"],
            "@shared/*": ["src/shared/*"],
            "@components/*": ["src/components/*"],
            "@features/*": ["src/features/*"],
            "@hooks/*": ["src/hooks/*"],
            "@utils/*": ["src/utils/*"],
            "@config/*": ["src/config/*"],
            "@api/*": ["src/api/*"],
            "@locales/*": ["src/locales/*"],
            "@styles/*": ["src/styles/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
